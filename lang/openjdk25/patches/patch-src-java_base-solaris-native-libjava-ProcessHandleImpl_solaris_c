+JNIEXPORT jobject JNICALL
+os_getCmdlineAndUserInfo(JNIEnv *env, jlong jpid) {
+    pid_t pid = (pid_t)jpid;
+    char path[PATH_MAX];
+    psinfo_t psinfo;
+    
+    snprintf(path, sizeof(path), "/proc/%d/psinfo", pid);
+    int fd = open(path, O_RDONLY);
+    if (fd == -1) {
+        return NULL;
+    }
+    
+    if (read(fd, &psinfo, sizeof(psinfo)) != sizeof(psinfo)) {
+        close(fd);
+        return NULL;
+    }
+    close(fd);
+    
+    // Get command line from pr_psargs
+    jstring jcmdline = (*env)->NewStringUTF(env, psinfo.pr_psargs);
+    
+    // Get user name from pr_uid (simplified - return NULL for now)
+    jstring juser = NULL;
+    
+    // Find ProcessHandle.Info class
+    jclass infoClass = (*env)->FindClass(env, "java/lang/ProcessHandle$Info");
+    if (infoClass == NULL) {
+        return NULL;
+    }
+    
+    // Get constructor
+    jmethodID constructor = (*env)->GetMethodID(env, infoClass, "<init>", 
+                                                  "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;JLjava/lang/String;)V");
+    if (constructor == NULL) {
+        return NULL;
+    }
+    
+    jobject info = (*env)->NewObject(env, infoClass, constructor,
+                                     jcmdline, NULL, juser, 0LL, NULL);
+    
+    return info;
+}

