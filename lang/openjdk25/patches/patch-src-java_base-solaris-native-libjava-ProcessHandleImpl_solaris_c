+JNIEXPORT jint JNICALL
+os_getParentPidAndTimings(JNIEnv *env, jlong jpid, 
+                          jlongArray jparentPidArray, 
+                          jlongArray jstimeArray, 
+                          jlongArray jutimeArray,
+                          jlongArray jctimeArray) {
+    pid_t pid = (pid_t)jpid;
+    char path[PATH_MAX];
+    psinfo_t psinfo;
+    
+    snprintf(path, sizeof(path), "/proc/%d/psinfo", pid);
+    int fd = open(path, O_RDONLY);
+    if (fd == -1) {
+        return -1;
+    }
+    
+    if (read(fd, &psinfo, sizeof(psinfo)) != sizeof(psinfo)) {
+        close(fd);
+        return -1;
+    }
+    close(fd);
+    
+    jlong parentPid = (jlong)psinfo.pr_ppid;
+    (*env)->SetLongArrayRegion(env, jparentPidArray, 0, 1, &parentPid);
+    
+    // On Solaris, pr_time is total CPU time (user+system)
+    // Use pr_time for both or split if needed
+    jlong total_time = (jlong)(psinfo.pr_time.tv_sec * 1000 + psinfo.pr_time.tv_nsec / 1000000);
+    // Approximate: give all to user time, 0 to system time
+    jlong utime = total_time;
+    jlong stime = 0;
+    jlong ctime = 0;
+    
+    (*env)->SetLongArrayRegion(env, jstimeArray, 0, 1, &stime);
+    (*env)->SetLongArrayRegion(env, jutimeArray, 0, 1, &utime);
+    (*env)->SetLongArrayRegion(env, jctimeArray, 0, 1, &ctime);
+    
+    return 0;
+}
