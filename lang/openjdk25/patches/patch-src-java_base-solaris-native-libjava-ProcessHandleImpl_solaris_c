+JNIEXPORT jint JNICALL
+os_getChildren(JNIEnv *env, jlong jpid, jlongArray jarray, 
+               jlongArray jparentArray, jlongArray jstimeArray, 
+               jlongArray jutimeArray, jlongArray jctimeArray,
+               jlongArray jpidArray) {
+    DIR* dir;
+    struct dirent* entry;
+    char path[PATH_MAX];
+    pid_t pid = (pid_t)jpid;
+    int count = 0;
+    
+    dir = opendir("/proc");
+    if (dir == NULL) {
+        return 0;
+    }
+    
+    while ((entry = readdir(dir)) != NULL) {
+        if (entry->d_name[0] >= '0' && entry->d_name[0] <= '9') {
+            pid_t child_pid = atoi(entry->d_name);
+            psinfo_t psinfo;
+            
+            snprintf(path, sizeof(path), "/proc/%d/psinfo", child_pid);
+            int fd = open(path, O_RDONLY);
+            if (fd != -1) {
+                if (read(fd, &psinfo, sizeof(psinfo)) == sizeof(psinfo)) {
+                    if (psinfo.pr_ppid == pid) {
+                        count++;
+                    }
+                }
+                close(fd);
+            }
+        }
+    }
+    
+    closedir(dir);
+    return count;
+}
