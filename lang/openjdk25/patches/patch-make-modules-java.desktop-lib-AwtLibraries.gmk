--- make/modules/java.desktop/lib/AwtLibraries.gmk.orig	2026-02-04 03:45:26.000000000 +0100
+++ make/modules/java.desktop/lib/AwtLibraries.gmk	2026-05-07 07:47:33.315210880 +0200
@@ -61,7 +61,7 @@
       #
 endif
 
-ifeq ($(call isTargetOs, linux macosx aix), true)
+ifeq ($(call isTargetOs, linux macosx aix solaris), true)
   LIBAWT_EXCLUDE_FILES += awt_Font.c CUPSfuncs.c fontpath.c X11Color.c
 endif
 
@@ -191,7 +191,7 @@
   $(eval $(call SetupJdkLibrary, BUILD_LIBAWT_HEADLESS, \
       NAME := awt_headless, \
       EXTRA_SRC := $(LIBAWT_HEADLESS_EXTRA_SRC), \
-      EXCLUDES := medialib, \
+      EXCLUDES := medialib $(if $(filter true,$(ENABLE_HEADLESS_ONLY)),x11), \
       ONLY_EXPORTED := $(LIBAWT_HEADLESS_ONLY_EXPORTED), \
       OPTIMIZATION := LOW, \
       CFLAGS := -DHEADLESS=true $(CUPS_CFLAGS) $(FONTCONFIG_CFLAGS) \
@@ -408,7 +408,7 @@
   LIBJAWT_EXCLUDE_SRC_PATTERNS := /unix/
 endif
 
-ifeq ($(call isTargetOs, linux)+$(ENABLE_HEADLESS_ONLY), true+true)
+ifeq ($(call isTargetOs, linux solaris)+$(ENABLE_HEADLESS_ONLY), true+true)
   LIBJAWT_CFLAGS += -DHEADLESS
 endif
 
@@ -417,7 +417,7 @@
 endif
 
 ifeq ($(call isTargetOsType, unix)+$(call isTargetOs, macosx), true+false)
-  LIBJAWT_JDK_LIBS_unix := libawt
+  LIBJAWT_JDK_LIBS_unix := libawt java.base:libjava
   ifeq ($(ENABLE_HEADLESS_ONLY), false)
     LIBJAWT_JDK_LIBS_unix += libawt_xawt
   else
