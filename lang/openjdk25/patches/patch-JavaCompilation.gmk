--- make/common/JavaCompilation.gmk.orig	2026-05-06 05:10:09.388802573 +0200
+++ make/common/JavaCompilation.gmk	2026-05-06 06:02:22.735504608 +0200
@@ -498,13 +498,13 @@
 
     # Do the actual compilation
     $$($1_COMPILE_TARGET): $$($1_SRCS) $$($1_FILELIST) $$($1_DEPENDS) \
-        $$($1_VARDEPS_FILE) $$($1_EXTRA_DEPS) $$($1_JAVAC_SERVER_CONFIG) \
-        $$($1_MODFILELIST_FIXED)
+        $$($1_VARDEPS_FILE) $$($1_EXTRA_DEPS) $$($1_JAVAC_SERVER_CONFIG) \
+        $$(if $$(filter buildjdk, $$($1_COMPILER)),,$$($1_MODFILELIST_FIXED))
 		$$(call MakeDir, $$(@D))
 		$$(call ExecuteWithLog, $$($1_BIN)$$($1_MODULE_SUBDIR)/_the.$$($1_SAFE_NAME)_batch, \
 		    $$($1_JAVAC_CMD) $$($1_FLAGS) \
		        $$($1_API_DIGEST_FLAGS) \
-		        -XDmodifiedInputs=$$($1_MODFILELIST_FIXED) \
+			$$(if $$(filter buildjdk, $$($1_COMPILER)),,-XDmodifiedInputs=$$($1_MODFILELIST_FIXED)) \
 		        -d $$($1_BIN) $$($1_HEADERS_ARG) @$$($1_FILELIST)) && \
 		$(TOUCH) $$@
 
